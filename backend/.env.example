# LLM（OpenAI 兼容接口：LiteLLM 网关 / DeepSeek / 豆包 Ark 均可）
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=http://litellm.starways.team/v1
OPENAI_MODEL=deepseek-v3
OPENAI_TIMEOUT=120
OPENAI_MAX_RETRIES=3
LLM_MAX_CONCURRENCY=3
LLM_JSON_MODE=false

# DeepSeek 官方接口：把 LLM_PROVIDER 改成 deepseek 后启用
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 可选：仅在确认接口支持时开启 thinking 扩展；默认不发送
DEEPSEEK_THINKING=
DEEPSEEK_REASONING_EFFORT=high

DB_PATH=./data/hh.db
UPLOAD_DIR=./data/uploads
# 团队访问的唯一线上/内网入口，用于飞书里的报告链接。
APP_PUBLIC_URL=https://agent.innoreal.cn
# 如果前后端同源部署，填 APP_PUBLIC_URL 即可；多域名或反向代理调试时用英文逗号分隔。
CORS_ALLOW_ORIGINS=https://agent.innoreal.cn
HOST=0.0.0.0
PORT=8720

# 飞书多维表格主数据同步：共享服务后端统一连接同一个 Base。
# FEISHU_BASE_TOKEN 只填 base token 本身，不要带 URL 或 base/ 前缀。
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=
FEISHU_BASE_TOKEN=base_token_without_base_prefix
FEISHU_TABLE_COMPANIES=tblxxx
FEISHU_TABLE_USERS=tblxxx
FEISHU_TABLE_PROJECTS=tblxxx
FEISHU_TABLE_POSITIONS=tblxxx
FEISHU_TABLE_PROMPTS=tblxxx
FEISHU_TABLE_JOB_LABELS=tblxxx
FEISHU_TABLE_MATCH_RESULTS=tblxxx
FEISHU_TABLE_CLIENT_RECOMMENDATIONS=tblxxx
FEISHU_TABLE_CHAT_MESSAGES=tblxxx
FEISHU_TABLE_TRACKING=tblxxx
FEISHU_SYNC_ENABLED=true
# 正式共享服务建议 true，避免本地缓存和飞书 Base 静默不一致。
FEISHU_SYNC_STRICT=true
